# ===== Wildcard Multi-Tenant Backend Configuration =====
PORT=3000
NODE_ENV=production

# 1. قاعدة البيانات الرئيسية (SuperWegz) - حيث جدول العملاء IClient
SUPER_MONGO_URI=mongodb://user:pass@host:27017/super_wegz?authSource=admin

# 2. قاعدة بيانات الـ Tenants (المكان الذي تُنشأ فيه قواعد بيانات العملاء sc_<id>)
TENANT_MONGO_URI=mongodb://127.0.0.1:27017

# 3. النطاق الأب الافتراضي (Wildcard Parent Domain)
PARENT_DOMAIN=wegz.org

# 4. توقيع الـ JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
